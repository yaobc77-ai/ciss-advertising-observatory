OBS_DATABASE_URL=postgresql://observatory:SET_LOCAL_PASSWORD@127.0.0.1:55432/observatory
OPENAI_API_KEY=
OBS_COOKIE_SECRET=SET_RANDOM_STABLE_SECRET
OBS_GENERATION_MODEL=gpt-5.6-luna
OBS_EMBEDDING_MODEL=text-embedding-3-small
OBS_MONTHLY_BUDGET_USD=100
OBS_REQUESTS_PER_MINUTE=5
OBS_REQUESTS_PER_DAY=30
OBS_CONCURRENCY=2
OBS_SHOW_SOURCE_LINKS=true
OBS_HOST=127.0.0.1
OBS_PORT=8050
# Hosted HTTPS deployment only (Railway sets PORT automatically)
OBS_SECURE_COOKIES=false
OBS_TRUSTED_PROXY=
# Model first understands the question, then calls constrained read-only tools.
# Interpretation uses the same configured model and API budget, including counts.
OBS_RESEARCH_AGENT_ENABLED=true
# Maintenance MCP only: local exact matches, then at most one paid source search.
# Candidate source associations always require human review.
OBS_CLAIMS_SOURCE_SEARCH_ENABLED=false
# Semantic questions only: at most one paid web lookup after missing corpus evidence.
# External sources are shown separately and never change corpus counts or records.
OBS_WEB_SEARCH_ENABLED=true
# Reviewed PDFs/previews are supplied separately from the application image.
OBS_RECORD_ASSET_ROOT=
OBS_RECORD_ASSET_MANIFEST_SHA256=
# Optional curated evaluation report for a frozen run, with separately frozen plan.
# Keep these empty until actual run and review evidence has been checked.
# Published measurements do not automatically validate the current application.
OBS_EVALUATION_REPORT_PATH=
OBS_EVALUATION_REPORT_SHA256=
OBS_EVALUATION_PLAN_SHA256=
# Optional reviewed decisions for the client's 24 native-ad content questions.
# Keep blank until a reviewed publication is prepared and selected by the operator.
OBS_CONTENT_PUBLICATION_PATH=
OBS_CONTENT_PUBLICATION_SHA256=
OBS_CONTENT_REVIEW_SHA256=
# Optional MCP-only typed media reads; these are server-selected local sources.
# Leave blank until a verified bundle and its saved asset root are available.
# This does not run OCR/transcription or enable media in web answer citations.
OBS_MEDIA_BUNDLE_PATH=
OBS_MEDIA_BUNDLE_SHA256=
OBS_MEDIA_ASSET_ROOT=
